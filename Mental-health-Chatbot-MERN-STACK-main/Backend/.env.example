# --- MongoDB ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/dbname?retryWrites=true&w=majority
# Only if TLS / certificate errors in dev (remove in production):
# MONGODB_TLS_INSECURE=true

# --- JWT ---
JWT_SECRET=change_me

# --- Verification links in email (must match the URL where users open your app) ---
# Hub (Vite) in this repo often uses port 8080; MERN chatbot uses 3000.
FRONTEND_URL=http://localhost:8080

# Branding (verification email HTML + subject)
# EMAIL_APP_NAME=Mindful
# EMAIL_VERIFY_SUBJECT=Verify your email – Mindful

# --- Gmail (recommended) — use an App Password, NOT your normal Gmail password ---
# EMAIL_USER must be the SAME Google account that creates the App Password below.
# Google Account → Security → 2-Step Verification → App passwords → https://myaccount.google.com/apppasswords
EMAIL_USER=youraddress@gmail.com
EMAIL_PASS=abcdefghijklmnop

# Optional overrides (defaults below work for Gmail):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# EMAIL_FROM=Mindful <youraddress@gmail.com>
# Verification emails go TO whatever address users type at signup — not EMAIL_USER. EMAIL_USER is only SMTP login.
# EMAIL_REPLY_TO=support@yourdomain.com

# --- Gemini (chat + AI insight recommendations) ---
API_KEY=
# Optional: GEMINI_MODEL=gemini-2.5-flash

# --- Web Push (device notifications for quotes + wellness score) ---
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@Mindful.app
